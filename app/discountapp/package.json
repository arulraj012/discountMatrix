{
  "name": "cust.discountapp",
  "version": "0.0.1",
  "description": "Discount Matrix Fiori Elements Application",
  "private": true,
  "devDependencies": {
    "@sap/ux-ui5-tooling": "^1",
    "@ui5/cli": "^4",
    "ui5-task-zipper": "^3"
  },
  "scripts": {
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "build:cf": "ui5 build preload --config=ui5-deploy.yaml --clean-dest --dest dist",
    "deploy-config": "npx fiori add deploy-config cf"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "ui5-task-zipper"
    ]
  }
}